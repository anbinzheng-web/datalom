{
  "name": "datalom",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=24.11 <25"
  },
  "scripts": {
    "predev": "pnpm db:generate && pnpm db:push && pnpm --filter '@datalom/server^...' build",
    "dev": "pnpm --parallel --filter @datalom/server --filter @datalom/worker --filter @datalom/admin-web --filter @datalom/web dev",
    "start": "node apps/server/dist/main.js",
    "worker": "node apps/worker/dist/main.js",
    "web:dev": "pnpm --filter @datalom/admin-web dev",
    "build": "pnpm db:generate && pnpm -r build",
    "format": "prettier --write \"apps/**/*.{ts,tsx,css,json}\" \"packages/**/*.{ts,tsx,css,json}\" \"*.{json,yaml,yml}\"",
    "format:check": "prettier --check \"apps/web/**/*.{ts,tsx,css,json}\" .prettierrc.json",
    "check": "pnpm format:check && pnpm contracts:check && tsc --noEmit && pnpm -r check",
    "test": "vitest run",
    "test:ui": "tsx --conditions=datalom-source scripts/ui-smoke.ts",
    "research": "tsx --conditions=datalom-source packages/platform-tiktok/research/tools/research.ts",
    "benchmark": "tsx --conditions=datalom-source scripts/benchmark.ts",
    "auth": "tsx --conditions=datalom-source scripts/auth.ts",
    "roxy:config": "tsx --conditions=datalom-source scripts/roxy-collect.ts --check",
    "roxy:collect": "tsx --conditions=datalom-source scripts/roxy-collect.ts",
    "diagnose": "tsx --conditions=datalom-source scripts/diagnose.ts",
    "doubao:guest": "tsx --conditions=datalom-source packages/platform-doubao/research/tools/roxy-guest-chat.ts",
    "doubao:node": "tsx --conditions=datalom-source packages/platform-doubao/research/tools/native-run.ts",
    "gost:install": "tsx --conditions=datalom-source scripts/install-gost.ts",
    "dev:server": "pnpm --filter '@datalom/server^...' build && pnpm --filter @datalom/server dev",
    "dev:worker": "pnpm --filter @datalom/worker dev",
    "dev:all": "pnpm dev",
    "contracts:generate": "tsx --conditions=datalom-source scripts/generate-contracts.mjs",
    "contracts:check": "tsx --conditions=datalom-source scripts/generate-contracts.mjs --check",
    "test:built": "node scripts/smoke-built.mjs",
    "db:generate": "prisma generate",
    "db:up": "docker compose up -d postgres",
    "db:push": "prisma db push"
  },
  "devDependencies": {
    "@datalom/network-node": "workspace:*",
    "@datalom/platform-tiktok": "workspace:*",
    "@datalom/server": "workspace:*",
    "@datalom/shared": "workspace:*",
    "@datalom/worker": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "ajv": "^8.17.1",
    "openapi-typescript": "^7.13.0",
    "playwright": "^1.55.0",
    "prettier": "^3.9.6",
    "prisma": "7.10.0",
    "tough-cookie": "^6.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
