{
  "name": "spider",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=24.11 <25"
  },
  "scripts": {
    "dev": "tsx apps/server/src/main.ts",
    "start": "tsx apps/server/src/main.ts",
    "worker": "tsx apps/worker/src/main.ts",
    "web:dev": "vite --config apps/web/vite.config.ts",
    "build": "vite build --config apps/web/vite.config.ts",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:ui": "tsx tools/ui-smoke.ts",
    "research": "tsx src/platforms/tiktok/tools/research.ts",
    "benchmark": "tsx tools/benchmark.ts",
    "auth": "tsx tools/auth.ts",
    "diagnose": "tsx tools/diagnose.ts",
    "doubao:guest": "tsx src/platforms/doubao/tools/roxy-guest-chat.ts",
    "doubao:node": "tsx src/platforms/doubao/tools/native-run.ts",
    "gost:install": "tsx tools/install-gost.ts"
  },
  "dependencies": {
    "@fastify/static": "^8.2.0",
    "@fastify/swagger": "^9.5.1",
    "@napi-rs/keyring": "^2.1.0",
    "@roxybrowser/openapi": "3.2.0",
    "better-sqlite3": "^12.0.0",
    "drizzle-orm": "^0.44.0",
    "fastify": "^5.6.0",
    "impit": "0.14.5",
    "linkedom": "0.18.12",
    "pino": "^9.9.0",
    "playwright": "^1.55.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tough-cookie": "^6.0.0"
  },
  "devDependencies": {
    "@babel/generator": "^8.0.5",
    "@babel/parser": "^8.0.5",
    "@babel/traverse": "^8.0.5",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.6",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
