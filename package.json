{
  "name": "datalom",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=24.11 <25"
  },
  "scripts": {
    "dev": "tsx --conditions=datalom-source apps/server/src/main.ts",
    "start": "node apps/server/dist/main.js",
    "worker": "node apps/worker/dist/main.js",
    "web:dev": "pnpm --filter @datalom/web dev",
    "build": "pnpm -r build",
    "check": "pnpm contracts:check && tsc --noEmit && pnpm -r check",
    "test": "vitest run",
    "test:ui": "tsx --conditions=datalom-source tools/ui-smoke.ts",
    "research": "tsx --conditions=datalom-source research/tiktok/tools/research.ts",
    "benchmark": "tsx --conditions=datalom-source tools/benchmark.ts",
    "auth": "tsx --conditions=datalom-source tools/auth.ts",
    "diagnose": "tsx --conditions=datalom-source tools/diagnose.ts",
    "doubao:guest": "tsx --conditions=datalom-source research/doubao/tools/roxy-guest-chat.ts",
    "doubao:node": "tsx --conditions=datalom-source research/doubao/tools/native-run.ts",
    "gost:install": "tsx --conditions=datalom-source tools/install-gost.ts",
    "dev:server": "pnpm --filter @datalom/server dev",
    "dev:worker": "pnpm --filter @datalom/worker dev",
    "contracts:generate": "node tools/generate-contracts.mjs",
    "contracts:check": "node tools/generate-contracts.mjs --check",
    "test:built": "node tools/smoke-built.mjs"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "prettier": "^3.9.6",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "playwright": "^1.55.0",
    "@datalom/server": "workspace:*",
    "@datalom/storage-node": "workspace:*",
    "@datalom/network-node": "workspace:*",
    "@datalom/runtime-node": "workspace:*",
    "tough-cookie": "^6.0.0",
    "@datalom/worker": "workspace:*",
    "openapi-typescript": "^7.13.0",
    "ajv": "^8.17.1",
    "@datalom/contracts-ts": "workspace:*",
    "@datalom/platform-tiktok": "workspace:*"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
