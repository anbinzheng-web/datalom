{
  "name": "@datalom/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./*": {
      "types": "./src/*.ts",
      "datalom-source": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json",
    "build": "node ../../scripts/build-package.mjs",
    "dev": "tsx --conditions=datalom-source src/main.ts",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@datalom/shared": "workspace:*"
  }
}
