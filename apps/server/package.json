{
  "name": "@datalom/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./*": {
      "types": "./src/*.ts",
      "datalom-source": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "test:smoke": "pnpm build && node test/smoke.mjs",
    "check": "tsc --noEmit -p tsconfig.json",
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "test:public-api": "pnpm build && node test/public-api.mjs"
  },
  "dependencies": {
    "@datalom/network-node": "workspace:*",
    "@datalom/platform-tiktok": "workspace:*",
    "@datalom/research-tiktok": "workspace:*",
    "@fastify/static": "^10.1.5",
    "@fastify/swagger": "^9.5.1",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-fastify": "^12.0.1",
    "fastify": "^5.6.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "tough-cookie": "^6.0.0",
    "@datalom/platform-instagram": "workspace:*",
    "@datalom/platform-facebook": "workspace:*",
    "@datalom/platform-x": "workspace:*",
    "@datalom/platform-doubao": "workspace:*",
    "@datalom/platform-youtube": "workspace:*",
    "@datalom/shared": "workspace:*"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.1.0",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.0"
  }
}
