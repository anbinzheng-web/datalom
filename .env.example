# Local PostgreSQL. Export in your shell before running pnpm commands.
DATABASE_URL=postgresql://YOUR_LOCAL_USER@localhost:5432/datalom
DATALOM_TEST_DATABASE_URL=postgresql://YOUR_LOCAL_USER@localhost:5432/datalom_test
# Docker Compose PostgreSQL defaults are for local development only.
POSTGRES_USER=datalom
POSTGRES_PASSWORD=datalom
POSTGRES_DB=datalom

# Optional local machine token (32+ random characters); unset keeps JWT login only.
# DATALOM_MANAGEMENT_TOKEN=
# Roxy connection used by research tools.
# ROXY_HOST=http://127.0.0.1:50000
# ROXY_WORKSPACE_ID=
# ROXY_API_KEY=

# Global platform-account request spacing, integer milliseconds (0..3600000).
DATALOM_ACCOUNT_INTERVAL_MS=3000
