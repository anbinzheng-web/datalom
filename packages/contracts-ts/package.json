{
  "name": "@datalom/contracts-ts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./*": {
      "types": "./src/*.ts",
      "datalom-source": "./src/*.ts",
      "default": "./dist/*.js"
    },
    ".": {
      "types": "./src/index.ts",
      "datalom-source": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json",
    "build": "node ../../tools/build-package.mjs"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  }
}
