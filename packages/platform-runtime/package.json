{
  "name": "@datalom/platform-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./*": {
      "types": "./src/*.ts",
      "datalom-source": "./src/*.ts",
      "default": "./dist/*.js"
    },
    "./contracts/*": {
      "types": "./src/contracts/*.ts",
      "datalom-source": "./src/contracts/*.ts",
      "default": "./dist/contracts/*.js"
    },
    "./fixtures/*": {
      "types": "./src/fixtures/*.ts",
      "datalom-source": "./src/fixtures/*.ts",
      "default": "./dist/fixtures/*.js"
    }
  },
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json",
    "build": "node ../../scripts/build-package.mjs"
  },
  "dependencies": {
    "cron-parser": "^5.10.1",
    "impit": "0.14.5",
    "socks": "^2.8.10",
    "undici": "^7.29.1",
    "zod": "^4.6.2"
  }
}
