{
  "name": "@datalom/platform-instagram",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./*": {
      "types": "./src/*.ts",
      "datalom-source": "./src/*.ts",
      "default": "./dist/*.js"
    },
    "./api/*": {
      "types": "./src/api/*.ts",
      "datalom-source": "./src/api/*.ts",
      "default": "./dist/api/*.js"
    }
  },
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json",
    "build": "node ../../scripts/build-package.mjs"
  },
  "dependencies": {
    "@datalom/network-node": "workspace:*",
    "impit": "0.14.5",
    "tough-cookie": "^6.0.0",
    "@datalom/platform-runtime": "workspace:*",
    "@datalom/shared": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^3.2.0",
    "playwright-core": "^1.63.0"
  }
}
