{
  "name": "@datalom/research-facebook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./*": {
      "types": "./src/*.ts",
      "datalom-source": "./src/*.ts",
      "default": "./dist/*.js"
    },
    "./tools/*": {
      "types": "./tools/*.ts",
      "datalom-source": "./tools/*.ts",
      "default": "./dist/tools/*.js"
    }
  },
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json",
    "build": "node ../../tools/build-package.mjs"
  },
  "dependencies": {
    "@datalom/network-node": "workspace:*",
    "@datalom/platform-facebook": "workspace:*",
    "@datalom/runtime-node": "workspace:*",
    "@datalom/storage-node": "workspace:*",
    "impit": "0.14.5",
    "playwright": "^1.55.0"
  }
}
